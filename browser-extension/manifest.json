{
  "manifest_version": 3,
  "name": "Smart Mirror Desktop Switcher",
  "version": "1.0.0",
  "description": "Leaves the mirror for a normal browser tab and returns with a keyboard shortcut.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "mirror-page.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "return-to-mirror": {
      "suggested_key": {
        "default": "Ctrl+Alt+M",
        "linux": "Ctrl+Alt+M"
      },
      "description": "Return to the Smart Mirror tab"
    }
  }
}
