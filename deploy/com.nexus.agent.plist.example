<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.nexus.agent</string>
<key>ProgramArguments</key><array>
<string>/ABSOLUTE/PATH/.venv/bin/python</string><string>/ABSOLUTE/PATH/nexus_agent.py</string>
<string>--config</string><string>/ABSOLUTE/PATH/config.local.json</string>
</array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardErrorPath</key><string>/ABSOLUTE/PATH/agent-error.log</string>
</dict></plist>
